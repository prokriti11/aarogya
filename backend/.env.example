# Neon: copy the connection string, change "postgresql://" to "postgresql+asyncpg://",
# and replace "?sslmode=require&channel_binding=require" with "?ssl=require"
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?ssl=require
GROQ_API_KEY=gsk_xxx
ADMIN_TOKEN=pick-a-long-random-string
CORS_ORIGINS=*

# LLM judge (free key at aistudio.google.com). Or set JUDGE_PROVIDER=groq and JUDGE_MODEL to a non-Llama Groq model.
GEMINI_API_KEY=
JUDGE_PROVIDER=gemini
JUDGE_MODEL=gemini-3.5-flash
