# Neon: copy the connection string, change "postgresql://" to "postgresql+asyncpg://",
# and replace "?sslmode=require&channel_binding=require" with "?ssl=require"
DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?ssl=require
GROQ_API_KEY=gsk_xxx
ADMIN_TOKEN=pick-a-long-random-string
CORS_ORIGINS=*

# LLM judge: a different model family from the gpt-oss bots.
# Default: Qwen on Groq (same GROQ_API_KEY). Gemini's free tier allows only 20 requests/day per model.
JUDGE_PROVIDER=groq
JUDGE_MODEL=qwen/qwen3.8-27b
# To use Gemini instead: JUDGE_PROVIDER=gemini, JUDGE_MODEL=gemini-3.5-flash, and set GEMINI_API_KEY
GEMINI_API_KEY=
